<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VISION — A Sua Próxima Versão</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #080a0f;
            --card-bg: #111622;
            --accent-blue: #00f2fe;
            --accent-glow: rgba(0, 242, 254, 0.25);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #1e293b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        nav {
            padding: 20px 0;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 3px;
            color: var(--text-main);
        }

        .logo span {
            color: var(--accent-blue);
        }

        .hero {
            padding: 60px 0 40px;
            text-align: center;
        }

        .badge {
            display: inline-block;
            background: rgba(0, 242, 254, 0.1);
            border: 1px solid var(--accent-blue);
            color: var(--accent-blue);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 2.8rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: -1px;
        }

        .hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 700px;
            margin: 0 auto 30px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 15px;
            margin: 30px 0 40px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 12px;
            text-align: center;
        }

        .stat-number {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--accent-blue);
            display: block;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
        }

        .btn-cta {
            display: inline-block;
            width: 100%;
            max-width: 450px;
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
            color: #fff;
            text-decoration: none;
            padding: 18px 30px;
            font-size: 1.05rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 10px;
            box-shadow: 0 10px 25px var(--accent-glow);
            transition: transform 0.2s, box-shadow 0.2s;
            text-align: center;
        }

        .btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px var(--accent-glow);
        }

        .btn-subtext {
            display: block;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 10px;
        }

        .transformation {
            padding: 60px 0;
            border-top: 1px solid var(--border-color);
        }

        .section-title {
            text-align: center;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 40px;
        }

        .before-after-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .photo-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 10px;
            position: relative;
            text-align: center;
        }

        .photo-img {
            width: 100%;
            height: 400px;
            border-radius: 8px;
            object-fit: cover;
            display: block;
        }

        .photo-tag {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 800;
            text-transform: uppercase;
            border: 1px solid var(--border-color);
        }

        .quote-box {
            background: var(--card-bg);
            border-left: 4px solid var(--accent-blue);
            padding: 20px;
            border-radius: 0 12px 12px 0;
            font-style: italic;
            color: #cbd5e1;
            margin-top: 20px;
            text-align: center;
        }

        .modules {
            padding: 60px 0;
            border-top: 1px solid var(--border-color);
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .module-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 25px;
            transition: border-color 0.3s;
        }

        .module-card:hover {
            border-color: var(--accent-blue);
        }

        .module-num {
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--accent-blue);
            margin-bottom: 10px;
            display: block;
        }

        .module-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .module-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .creator {
            padding: 60px 0;
            border-top: 1px solid var(--border-color);
            text-align: center;
        }

        .creator-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 40px 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .creator-img {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 20px;
            border: 3px solid var(--accent-blue);
            display: block;
        }

        .reviews {
            padding: 60px 0;
            border-top: 1px solid var(--border-color);
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .review-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }

        .review-author {
            font-weight: 700;
            color: var(--accent-blue);
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: block;
        }

        .review-card p {
            font-size: 0.9rem;
            color: #cbd5e1;
        }

        .cta-final {
            padding: 80px 0;
            border-top: 1px solid var(--border-color);
            text-align: center;
            background: radial-gradient(circle at center, rgba(0, 242, 254, 0.08) 0%, transparent 70%);
        }

        footer {
            padding: 30px 0;
            border-top: 1px solid var(--border-color);
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            h1 { font-size: 2.1rem; }
            .hero p { font-size: 0.95rem; }
            .photo-img { height: 350px; }
        }
    </style>
</head>
